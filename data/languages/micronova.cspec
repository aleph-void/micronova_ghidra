<?xml version="1.0" encoding="UTF-8"?>

<!-- microNOVA calling convention as the hardware supports it: JSR leaves the return address in
     AC3; routines that use the stack save AC0-AC2, FP and AC3/carry with SAV and return with RET.
     The stack grows upwards (PSHA increments SP, then stores). There is no compiler ABI, so
     the arguments and the result in accumulators are a default only. -->
<compiler_spec>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="SP" space="ram" growth="positive"/>
  <returnaddress>
    <register name="AC3"/>
  </returnaddress>
  <default_proto>
    <prototype name="__stdcall" strategy="register" extrapop="0" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="2">
          <register name="AC0"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="AC1"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="AC2"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="2">
          <register name="AC0"/>
        </pentry>
      </output>
      <killedbycall>
        <register name="AC0"/>
        <register name="AC1"/>
        <register name="AC2"/>
        <register name="AC3"/>
        <register name="C"/>
      </killedbycall>
    </prototype>
  </default_proto>
</compiler_spec>

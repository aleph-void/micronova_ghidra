# sleigh include file for Micronova language instructions
#
# Formats (Data General numbers bits 0-15 from the MSB; this file numbers them 15-0 from the LSB):
#   000 op @ idx disp       JMP JSR ISZ DSZ                 (no accumulator, memory reference)
#   0 op ac @ idx disp      LDA (op=01) STA (op=10)         (one accumulator, memory reference)
#   011 ac ioop ctl dev     NIO DIA DOA DIB DOB DIC DOC SKP  (I/O; device 01 = stack and MUL/DIV,
#                                                             device 77 = CPU)
#   1 acs acd aop sh cy # skip                              (two-accumulator arithmetic/logic)
#   1 acs acd trap# 1000                                    (TRAP: no-load with "never skip")
# Effective address: idx 0 = page zero (disp 0-255), 1 = PC + disp, 2 = AC2 + disp,
# 3 = AC3 + disp (disp signed for idx 1-3), all modulo 2^15. @ = indirect: the word at the
# address is the next address; its bit 15 (DG bit 0) requests another level. Locations 20-27
# (octal) are incremented and 30-37 decremented before they are used as indirect pointers.

define token instr(16)
	alc     = (15,15)
	op3     = (13,15)
	op2     = (11,12)
	ac      = (11,12)
	acs     = (13,14)
	acd     = (11,12)
	ind     = (10,10)
	idx     = (8,9)
	disp    = (0,7)
	sdisp   = (0,7) signed
	ioop    = (8,10)
	ctl     = (6,7)
	dev     = (0,5)
	aop     = (8,10)
	sh      = (6,7)
	cy      = (4,5)
	nl      = (3,3)
	skip    = (0,2)
	trapno  = (4,10)
;

attach variables [ ac acs acd ] [ AC0 AC1 AC2 AC3 ];

# ---------------------------------------------------------------------------------------------
# Effective address (word address, exported as a value)
# ---------------------------------------------------------------------------------------------

# Follow an indirect chain starting with the pointer at address a.
# The first level is written out so that the usual single indirection through a constant
# address decompiles without the loop.
macro indirect(a) {
	local blk:2 = a & 0x7ff8;
	*[ram]:2 a = *[ram]:2 a + zext(blk == 0x10) - zext(blk == 0x18);
	local p:2 = *[ram]:2 a;
	a = p & 0x7fff;
	if ((p & 0x8000) == 0) goto <done>;
<loop>
	blk = a & 0x7ff8;
	*[ram]:2 a = *[ram]:2 a + zext(blk == 0x10) - zext(blk == 0x18);
	p = *[ram]:2 a;
	a = p & 0x7fff;
	if ((p & 0x8000) != 0) goto <loop>;
<done>
}

Base: disp is idx=0 & disp { export *[const]:2 disp; }
Base: tgt is idx=1 & sdisp [ tgt = (inst_start + sdisp) & 0x7fff; ] { export *[const]:2 tgt; }
Base: sdisp,AC2 is idx=2 & sdisp & AC2 { local a:2 = (AC2 + sdisp) & 0x7fff; export a; }
Base: sdisp,AC3 is idx=3 & sdisp & AC3 { local a:2 = (AC3 + sdisp) & 0x7fff; export a; }

EA: Base is ind=0 & Base { export Base; }
EA: "@"^Base is ind=1 & Base { local a:2 = Base; indirect(a); export a; }

# Direct targets for flow (page zero or PC relative, not indirect)
DTgt: disp is ind=0 & idx=0 & disp { export *[ram]:2 disp; }
DTgt: tgt is ind=0 & idx=1 & sdisp [ tgt = (inst_start + sdisp) & 0x7fff; ] { export *[ram]:2 tgt; }

# ---------------------------------------------------------------------------------------------
# Memory reference
# ---------------------------------------------------------------------------------------------

:JMP DTgt is op3=0 & op2=0 & DTgt { goto DTgt; }
:JMP EA is op3=0 & op2=0 & EA { goto [EA]; }
# JMP 0,3 is the usual subroutine return (JSR leaves the return address in AC3)
:JMP EA is op3=0 & op2=0 & ind=0 & idx=3 & disp=0 & EA { return [AC3]; }
# The effective address is computed before AC3 receives the return address.
# (inst_next in p-code is a byte offset in this word-addressed space, so the return address is
# taken from the disassembly-time value, which is in words)
NextW: ret is epsilon [ ret = inst_next; ] { export *[const]:2 ret; }
HereW: here is epsilon [ here = inst_start; ] { export *[const]:2 here; }
:JSR DTgt is op3=0 & op2=1 & DTgt & NextW { AC3 = NextW; call DTgt; }
:JSR EA is op3=0 & op2=1 & EA & NextW { local t:2 = EA; AC3 = NextW; call [t]; }
:ISZ EA is op3=0 & op2=2 & EA {
	local a:2 = EA;
	local v:2 = *[ram]:2 a + 1;
	*[ram]:2 a = v;
	if (v == 0) goto inst_next2;
}
:DSZ EA is op3=0 & op2=3 & EA {
	local a:2 = EA;
	local v:2 = *[ram]:2 a - 1;
	*[ram]:2 a = v;
	if (v == 0) goto inst_next2;
}
:LDA ac,EA is op3=1 & ac & EA { ac = *[ram]:2 EA; }
:STA ac,EA is op3=2 & ac & EA { *[ram]:2 EA = ac; }

# ---------------------------------------------------------------------------------------------
# Two-accumulator arithmetic and logic
#   carry base (cy): "" current carry, Z 0, O 1, C complement
#   operation on ACS/ACD gives a 16-bit result; COM/NEG/INC/ADC/SUB/ADD complement the carry
#   base on a carry out; shift (sh): L rotate left through carry, R rotate right, S swap bytes;
#   "#" (no-load): neither ACD nor carry is changed; skip tests the shifted result and carry.
# ---------------------------------------------------------------------------------------------

Cy: ""  is cy=0 { local c:1 = C; export c; }
Cy: "Z" is cy=1 { export 0:1; }
Cy: "O" is cy=2 { export 1:1; }
Cy: "C" is cy=3 { local c:1 = !C; export c; }
Sh: ""  is sh=0 { }
Sh: "L" is sh=1 { }
Sh: "R" is sh=2 { }
Sh: "S" is sh=3 { }
NL: ""  is nl=0 { }
NL: "#" is nl=1 { }
Skip: ""     is skip=0 { }
Skip: ",SKP" is skip=1 { }
Skip: ",SZC" is skip=2 { }
Skip: ",SNC" is skip=3 { }
Skip: ",SZR" is skip=4 { }
Skip: ",SNR" is skip=5 { }
Skip: ",SEZ" is skip=6 { }
Skip: ",SBN" is skip=7 { }

# (no-load with "never skip" is TRAP, so the constructors exclude nl=1 & skip=0)
# shift (sh), load unless no-load, then skip; r:2 result, k:1 carry
macro finish(r, k, shf, nlf, skf, d) {
	local res:2 = r; local cr:1 = k;
	local shv:1 = shf; local nlv:1 = nlf; local skv:1 = skf;
	if (shv == 0) goto <shifted>;
	if (shv != 1) goto <notl>;
	local outl:1 = res[15,1];
	res = (res << 1) | zext(cr);
	cr = outl;
	goto <shifted>;
<notl>
	if (shv != 2) goto <swap>;
	local outr:1 = res[0,1];
	res = (res >> 1) | (zext(cr) << 15);
	cr = outr;
	goto <shifted>;
<swap>
	res = (res << 8) | (res >> 8);
<shifted>
	local doskip:1 = (skv == 1) || (skv == 2 && cr == 0) || (skv == 3 && cr != 0) ||
	                 (skv == 4 && res == 0) || (skv == 5 && res != 0) ||
	                 (skv == 6 && (cr == 0 || res == 0)) || (skv == 7 && cr != 0 && res != 0);
	if (nlv == 1) goto <noload>;
	d = res; C = cr;
<noload>
	if (doskip) goto inst_next2;
}

:COM^Cy^Sh^NL acs,acd^Skip is alc=1 & aop=0 & (nl=0 | skip!=0) & Cy & Sh & NL & acs & acd & Skip & sh & nl & skip {
	local r:2 = ~acs; local k:1 = Cy;
	finish(r, k, sh, nl, skip, acd);
}
:NEG^Cy^Sh^NL acs,acd^Skip is alc=1 & aop=1 & (nl=0 | skip!=0) & Cy & Sh & NL & acs & acd & Skip & sh & nl & skip {
	local s:2 = acs; local r:2 = -s; local k:1 = Cy ^ (s == 0);
	finish(r, k, sh, nl, skip, acd);
}
:MOV^Cy^Sh^NL acs,acd^Skip is alc=1 & aop=2 & (nl=0 | skip!=0) & Cy & Sh & NL & acs & acd & Skip & sh & nl & skip {
	local r:2 = acs; local k:1 = Cy;
	finish(r, k, sh, nl, skip, acd);
}
:INC^Cy^Sh^NL acs,acd^Skip is alc=1 & aop=3 & (nl=0 | skip!=0) & Cy & Sh & NL & acs & acd & Skip & sh & nl & skip {
	local s:2 = acs; local r:2 = s + 1; local k:1 = Cy ^ (s == 0xffff);
	finish(r, k, sh, nl, skip, acd);
}
:ADC^Cy^Sh^NL acs,acd^Skip is alc=1 & aop=4 & (nl=0 | skip!=0) & Cy & Sh & NL & acs & acd & Skip & sh & nl & skip {
	local s:2 = ~acs; local d:2 = acd; local r:2 = s + d; local k:1 = Cy ^ carry(s, d);
	finish(r, k, sh, nl, skip, acd);
}
:SUB^Cy^Sh^NL acs,acd^Skip is alc=1 & aop=5 & (nl=0 | skip!=0) & Cy & Sh & NL & acs & acd & Skip & sh & nl & skip {
	local s:2 = acs; local d:2 = acd; local r:2 = d - s; local k:1 = Cy ^ (s <= d);
	finish(r, k, sh, nl, skip, acd);
}
:ADD^Cy^Sh^NL acs,acd^Skip is alc=1 & aop=6 & (nl=0 | skip!=0) & Cy & Sh & NL & acs & acd & Skip & sh & nl & skip {
	local s:2 = acs; local d:2 = acd; local r:2 = s + d; local k:1 = Cy ^ carry(s, d);
	finish(r, k, sh, nl, skip, acd);
}
:AND^Cy^Sh^NL acs,acd^Skip is alc=1 & aop=7 & (nl=0 | skip!=0) & Cy & Sh & NL & acs & acd & Skip & sh & nl & skip {
	local r:2 = acs & acd; local k:1 = Cy;
	finish(r, k, sh, nl, skip, acd);
}

# TRAP (microNOVA): no-load with "never skip". The address of the TRAP is stored in location 46
# (octal) with bit 15 clear, then a "jump indirect" through location 47 (octal). ACS, ACD and the
# trap number are for the trap handler (it reads them from the stored instruction).
:TRAP acs,acd,trapno is alc=1 & nl=1 & skip=0 & acs & acd & trapno & HereW {
	*[ram]:2 0x26:2 = HereW & 0x7fff;
	local a:2 = 0x27;
	indirect(a);
	call [a];
}

# ---------------------------------------------------------------------------------------------
# Input/output
# ---------------------------------------------------------------------------------------------

Dev: "MDV"  is dev=0x01 { export 0x01:1; }
Dev: "HHC"  is dev=0x04 { export 0x04:1; }
Dev: "PROG" is dev=0x05 { export 0x05:1; }
Dev: "TTI"  is dev=0x08 { export 0x08:1; }
Dev: "TTO"  is dev=0x09 { export 0x09:1; }
Dev: "DKT2" is dev=0x18 { export 0x18:1; }
Dev: "DKT"  is dev=0x1b { export 0x1b:1; }
Dev: "TTI1" is dev=0x28 { export 0x28:1; }
Dev: "TTO1" is dev=0x29 { export 0x29:1; }
Dev: "DKT3" is dev=0x38 { export 0x38:1; }
Dev: "DKT1" is dev=0x3b { export 0x3b:1; }
Dev: dev    is dev { export *[const]:1 dev; }

# Busy/Done control: S start, C clear, P pulse (the CPU device uses S/C for Interrupt On)
F: ""  is ctl=0 { }
F: "S" is ctl=1 & Dev { io_start(Dev); }
F: "C" is ctl=2 & Dev { io_clear(Dev); }
F: "P" is ctl=3 & Dev { io_pulse(Dev); }
FC: ""  is ctl=0 { }
FC: "S" is ctl=1 { ION = 1; }
FC: "C" is ctl=2 { ION = 0; }
FC: "P" is ctl=3 { }

T: "BN" is ctl=0 & Dev { local t:1 = io_busy(Dev); export t; }
T: "BZ" is ctl=1 & Dev { local b:1 = io_busy(Dev); local t:1 = !b; export t; }
T: "DN" is ctl=2 & Dev { local t:1 = io_done(Dev); export t; }
T: "DZ" is ctl=3 & Dev { local b:1 = io_done(Dev); local t:1 = !b; export t; }
# CPU skip: BN/BZ test Interrupt On, DN never skips, DZ always skips
TC: "BN" is ctl=0 { local t:1 = ION != 0; export t; }
TC: "BZ" is ctl=1 { local t:1 = ION == 0; export t; }
TC: "DN" is ctl=2 { export 0:1; }
TC: "DZ" is ctl=3 { export 1:1; }

# generic devices
:NIO^F Dev     is op3=3 & ioop=0 & F & Dev                 { build F; }
:DIA^F ac,Dev  is op3=3 & ioop=1 & F & Dev & ac            { ac = io_in_a(Dev); build F; }
:DOA^F ac,Dev  is op3=3 & ioop=2 & F & Dev & ac            { io_out_a(Dev, ac); build F; }
:DIB^F ac,Dev  is op3=3 & ioop=3 & F & Dev & ac            { ac = io_in_b(Dev); build F; }
:DOB^F ac,Dev  is op3=3 & ioop=4 & F & Dev & ac            { io_out_b(Dev, ac); build F; }
:DIC^F ac,Dev  is op3=3 & ioop=5 & F & Dev & ac            { ac = io_in_c(Dev); build F; }
:DOC^F ac,Dev  is op3=3 & ioop=6 & F & Dev & ac            { io_out_c(Dev, ac); build F; }
:SKP^T Dev     is op3=3 & ioop=7 & T & Dev                 { if (T) goto inst_next2; }


# device 01: stack (microNOVA) and multiply/divide
:PSHA ac  is op3=3 & ioop=3 & ctl=0 & dev=1 & ac           { SP = SP + 1; *[ram]:2 SP = ac; }
:POPA ac  is op3=3 & ioop=3 & ctl=2 & dev=1 & ac           { ac = *[ram]:2 SP; SP = SP - 1; }
:MTSP ac  is op3=3 & ioop=2 & ctl=0 & dev=1 & ac           { SP = ac & 0x7fff; }
:MFSP ac  is op3=3 & ioop=2 & ctl=2 & dev=1 & ac           { ac = SP & 0x7fff; }
:MTFP ac  is op3=3 & ioop=0 & ctl=0 & dev=1 & ac           { FP = ac & 0x7fff; }
:MFFP ac  is op3=3 & ioop=0 & ctl=2 & dev=1 & ac           { ac = FP & 0x7fff; }
# SAV pushes AC0, AC1, AC2, FP and (carry, AC3 bits 14-0); then FP and AC3 = SP
:SAV      is op3=3 & ioop=5 & ctl=0 & dev=1 & ac=0 {
	local w:2 = (zext(C) << 15) | (AC3 & 0x7fff);
	local f:2 = FP;
	SP = SP + 1; *[ram]:2 SP = AC0;
	SP = SP + 1; *[ram]:2 SP = AC1;
	SP = SP + 1; *[ram]:2 SP = AC2;
	SP = SP + 1; *[ram]:2 SP = f;
	SP = SP + 1; *[ram]:2 SP = w;
	FP = SP; AC3 = SP;
}
# RET: SP = FP, then pop carry/PC, AC3, AC2, AC1, AC0
:RET      is op3=3 & ioop=5 & ctl=2 & dev=1 & ac=0 {
	SP = FP;
	local w:2 = *[ram]:2 SP; SP = SP - 1;
	AC3 = *[ram]:2 SP; SP = SP - 1;
	AC2 = *[ram]:2 SP; SP = SP - 1;
	AC1 = *[ram]:2 SP; SP = SP - 1;
	AC0 = *[ram]:2 SP; SP = SP - 1;
	C = w[15,1];
	local t:2 = w & 0x7fff;
	return [t];
}
# MUL: AC0:AC1 = AC1 * AC2 + AC0 (unsigned)
:MUL      is op3=3 & ioop=6 & ctl=3 & dev=1 & ac=2 {
	local p:4 = zext(AC1) * zext(AC2) + zext(AC0);
	AC0 = p(2); AC1 = p:2;
}
# DIV: AC0:AC1 / AC2 -> quotient AC1, remainder AC0, carry 0; if AC0 >= AC2, carry 1 and nothing
# else changes
:DIV      is op3=3 & ioop=6 & ctl=1 & dev=1 & ac=2 {
	if (AC0 >= AC2) goto <ovf>;
	local n:4 = (zext(AC0) << 16) | zext(AC1);
	local d:4 = zext(AC2);
	local q:4 = n / d; local r:4 = n % d;
	AC1 = q:2; AC0 = r:2; C = 0;
	goto inst_next;
<ovf>
	C = 1;
}

# device 04: hand-held console. READS: the console switches register is read from location
# 77577 (octal).
:READS ac is op3=3 & ioop=1 & ctl=0 & dev=4 & ac { ac = *[ram]:2 0x7f7f:2; }

# device 77: CPU. Bits 8-9 (S/C) set or clear Interrupt On instead of Busy/Done.
:INTEN    is op3=3 & ioop=0 & ctl=1 & dev=0x3f { ION = 1; }
:INTDS    is op3=3 & ioop=0 & ctl=2 & dev=0x3f { ION = 0; }
:NIO^FC "CPU" is op3=3 & ioop=0 & FC & dev=0x3f { build FC; }
:INTA ac  is op3=3 & ioop=3 & ctl=0 & dev=0x3f & ac { ac = interrupt_acknowledge(); }
:DIB^FC ac,"CPU" is op3=3 & ioop=3 & FC & dev=0x3f & ac { ac = interrupt_acknowledge(); build FC; }
:MSKO ac  is op3=3 & ioop=4 & ctl=0 & dev=0x3f & ac { MASK = ac; }
:DOB^FC ac,"CPU" is op3=3 & ioop=4 & FC & dev=0x3f & ac { MASK = ac; build FC; }
:IORST^FC is op3=3 & ioop=2 & FC & dev=0x3f & ac=0 { io_reset(); MASK = 0; rtc_disable(); build FC; }
:RTCDS^FC is op3=3 & ioop=2 & FC & dev=0x3f & ac=1 { rtc_disable(); build FC; }
:RTCEN^FC is op3=3 & ioop=2 & FC & dev=0x3f & ac=2 { rtc_enable(); build FC; }
:DOA^FC "AC3,CPU" is op3=3 & ioop=2 & FC & dev=0x3f & ac=3 { build FC; }
# HALT (DOC 0,CPU; the accumulator and f are ignored) sets Interrupt On and stops until an
# interrupt
:HALT     is op3=3 & ioop=6 & dev=0x3f { ION = 1; halt(); }
:DIA^FC ac,"CPU" is op3=3 & ioop=1 & FC & dev=0x3f & ac { ac = io_in_a(0x3f:1); build FC; }
:DIC^FC ac,"CPU" is op3=3 & ioop=5 & FC & dev=0x3f & ac { ac = io_in_c(0x3f:1); build FC; }
:SKP^TC "CPU" is op3=3 & ioop=7 & TC & dev=0x3f { if (TC) goto inst_next2; }
